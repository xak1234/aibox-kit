[Unit]
Description=aibox boxagent - box manager web UI and auto-fix agent
After=network-online.target aibox-llama-swap.service
Wants=network-online.target

[Service]
User=aibox
Group=aibox
EnvironmentFile=/etc/aibox/aibox.env
WorkingDirectory=/var/lib/aibox
ExecStart=/opt/aibox/venv/bin/python /opt/aibox/boxagent/boxagent.py
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
