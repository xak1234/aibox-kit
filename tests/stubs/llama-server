#!/usr/bin/python3
"""Stand-in for llama.cpp's llama-server, for testing the kit without a GPU or a real model.
Answers the endpoints modelbench and llama-swap use with canned replies."""
import json, os, sys, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

a = sys.argv[1:]
def opt(*names, default=None):
    for n in names:
        if n in a and a.index(n) + 1 < len(a):
            return a[a.index(n) + 1]
    return default
if "--version" in a:
    print("version: 9999 (stub)"); sys.exit(0)
PORT = int(opt("--port", default="8080")); HOST = opt("--host", default="127.0.0.1")
MODEL = opt("-m", "--model", default="stub.gguf"); ALIAS = opt("--alias", default=os.path.basename(MODEL)[:-5])
CTX = int(opt("-c", "--ctx-size", default="4096"))
time.sleep(float(os.environ.get("STUB_LOAD_S", "1")))
ANSWER = "Paris. 42. ok"

class H(BaseHTTPRequestHandler):
    def log_message(self, *x): pass
    def send(self, code, obj, ct="application/json"):
        b = json.dumps(obj).encode() if not isinstance(obj, bytes) else obj
        self.send_response(code); self.send_header("Content-Type", ct); self.send_header("Content-Length", str(len(b))); self.end_headers(); self.wfile.write(b)
    def do_GET(self):
        p = self.path.split("?")[0]
        if p == "/health": return self.send(200, {"status": "ok"})
        if p in ("/v1/models", "/models"): return self.send(200, {"object": "list", "data": [{"id": ALIAS, "object": "model"}]})
        if p == "/props": return self.send(200, {"model_alias": ALIAS, "chat_template_caps": {"supports_tools": True, "supports_tool_calls": True},
                                                 "default_generation_settings": {"n_ctx": CTX}})
        if p == "/slots": return self.send(200, [{"id": 0, "is_processing": False, "n_ctx": CTX}])
        if p == "/tools": return self.send(200, [])
        if p == "/metrics": return self.send(200, b"", "text/plain")
        self.send(404, {"error": "not found"})
    def do_POST(self):
        n = int(self.headers.get("Content-Length") or 0); body = json.loads(self.rfile.read(n) or b"{}")
        usage = {"prompt_tokens": 20, "completion_tokens": 8, "total_tokens": 28}
        timings = {"prompt_n": 20, "prompt_ms": 10.0, "prompt_per_second": 2000.0, "predicted_n": 8, "predicted_ms": 80.0, "predicted_per_second": 100.0}
        if body.get("stream"):
            self.send_response(200); self.send_header("Content-Type", "text/event-stream"); self.end_headers()
            for w in ANSWER.split(" "):
                ch = {"choices": [{"index": 0, "delta": {"content": w + " "}, "finish_reason": None}], "model": ALIAS}
                self.wfile.write(b"data: " + json.dumps(ch).encode() + b"\n\n"); self.wfile.flush(); time.sleep(0.02)
            fin = {"choices": [{"index": 0, "delta": {}, "finish_reason": "stop"}], "usage": usage, "timings": timings}
            self.wfile.write(b"data: " + json.dumps(fin).encode() + b"\n\ndata: [DONE]\n\n"); self.wfile.flush(); return
        self.send(200, {"id": "x", "object": "chat.completion", "model": ALIAS, "usage": usage, "timings": timings,
                        "choices": [{"index": 0, "finish_reason": "stop", "message": {"role": "assistant", "content": ANSWER}}]})

ThreadingHTTPServer((HOST, PORT), H).serve_forever()
